generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  SCANNER
}

enum MovieCategory {
  CINE
  TEATRO
  CONCIERTO
}

enum EventStatus {
  NOW_SHOWING
  COMING_SOON
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  EXPIRED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole      @default(CLIENT)
  createdAt    DateTime      @default(now()) @map("created_at")
  reservations Reservation[]

  @@map("users")
}

model MovieEvent {
  id        String          @id @default(cuid())
  title     String
  synopsis  String
  duration  Int
  category  MovieCategory
  posterUrl String          @map("poster_url")
  trailerUrl String?        @map("trailer_url")
  rating    Decimal?        @db.Decimal(2, 1)
  status    EventStatus     @default(NOW_SHOWING)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  showtimes Showtime[]

  @@index([status, category])
  @@map("movie_events")
}

model Room {
  id         String     @id @default(cuid())
  name       String
  capacity   Int
  seatLayout Json       @map("seat_layout")
  showtimes  Showtime[]

  @@map("rooms")
}

model Showtime {
  id            String        @id @default(cuid())
  movieId       String        @map("movie_id")
  roomId        String        @map("room_id")
  startTime     DateTime      @map("start_time")
  price         Decimal       @db.Decimal(10, 2)
  availableSeats Int          @default(0) @map("available_seats")
  movie         MovieEvent    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservations  Reservation[]

  @@unique([movieId, roomId, startTime])
  @@index([startTime])
  @@index([movieId])
  @@map("showtimes")
}

model Reservation {
  id        String             @id @default(cuid())
  showtimeId String            @map("showtime_id")
  userId    String             @map("user_id")
  status    ReservationStatus  @default(PENDING)
  expiresAt DateTime?          @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  showtime  Showtime           @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@index([showtimeId, status])
  @@index([userId, status])
  @@map("reservations")
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String       @map("reservation_id")
  seatNumber    String       @map("seat_number")
  qrCodeHash    String       @unique @map("qr_code_hash")
  status        TicketStatus @default(VALID)
  usedAt        DateTime?    @map("used_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([status])
  @@map("tickets")
}
